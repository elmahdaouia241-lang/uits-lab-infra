# /var/lib/suricata/rules/local.rules - regles locales UITS lab.lan (SID 1000001 et plus)
# Elles completent les ~50 000 regles Emerging Threats Open.

# Force brute SSH : 5 tentatives de connexion en 60 s depuis la meme source
alert tcp any any -> $HOME_NET 22 (msg:"UITS SSH brute force (5 SYN/60s)"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000001; rev:1;)

# Balayage ICMP : plus de 20 echos en 10 s
alert icmp any any -> $HOME_NET any (msg:"UITS ICMP sweep (20 echo/10s)"; itype:8; threshold:type both, track by_src, count 20, seconds 10; classtype:network-scan; sid:1000002; rev:1;)

# Scan de ports SYN : plus de 30 SYN en 5 s depuis la meme source
alert tcp any any -> $HOME_NET any (msg:"UITS TCP SYN port scan (30 SYN/5s)"; flags:S; threshold:type both, track by_src, count 30, seconds 5; classtype:network-scan; sid:1000003; rev:1;)

# Acces non autorise a l'interface web Zabbix depuis un hote hors VLAN admin
alert http !192.168.10.0/24 any -> 192.168.20.132 any (msg:"UITS acces web Zabbix depuis hote non admin"; flow:to_server,established; http.uri; content:"/zabbix"; startswith; classtype:policy-violation; sid:1000004; rev:1;)

# Telechargement de scripts via Squid / curl depuis un serveur (exfiltration ou dropper)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"UITS HTTP User-Agent curl/wget depuis un serveur"; flow:to_server; http.user_agent; content:"curl/"; startswith; classtype:policy-violation; sid:1000005; rev:1;)
