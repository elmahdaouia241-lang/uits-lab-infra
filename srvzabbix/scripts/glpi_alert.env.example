# Modele : copier en /etc/zabbix/glpi_alert.env, puis
#   sudo chown zabbix:zabbix /etc/zabbix/glpi_alert.env && sudo chmod 600 /etc/zabbix/glpi_alert.env
# Les vrais jetons se generent dans GLPI : Configuration > General > API,
# puis Preferences de l'utilisateur > Cle d'acces distant (User Token).
# NE JAMAIS committer le vrai fichier.
GLPI_URL="http://192.168.20.141"
APP_TOKEN="REMPLACER_PAR_LE_APP_TOKEN"
USER_TOKEN="REMPLACER_PAR_LE_USER_TOKEN"
